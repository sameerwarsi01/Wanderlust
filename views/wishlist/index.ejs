<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-3">
    <div class="col-12">
        <h3 class="fw-bold">My Wishlist</h3>
        <p class="text-muted">Your saved places for upcoming trips.</p>
    </div>
</div>

<% if (wishlist && wishlist.length > 0) { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mb-5">
        <% for(let listing of wishlist) { %>
            <div class="col">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card h-100 listing-card border-0 shadow-sm rounded-4 overflow-hidden">
                        <img 
                            src="<%= (listing.image && listing.image.url) ? listing.image.url : (listing.image || '/images/default.jpg') %>" 
                            class="card-img-top" 
                            alt="<%= listing.title %>" 
                            style="height: 18rem; object-fit: cover;"
                        />
                        <div class="card-body px-2 py-3">
                            <p class="card-text mb-0">
                                <b class="fs-6"><%= listing.title %></b><br>
                                <span class="text-muted small"><%= listing.location %>, <%= listing.country %></span><br>
                                <span class="fw-semibold">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span> 
                                <span class="text-muted small">/ night</span>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
<% } else { %>
    <div class="text-center py-5 my-5">
        <i class="fa-regular fa-heart fa-3x text-muted mb-3"></i>
        <h4>Your wishlist is empty!</h4>
        <p class="text-muted">Explore places and tap the heart icon to save your favorites.</p>
        <a href="/listings" class="btn btn-danger px-4 py-2 mt-2">Explore Listings</a>
    </div>
<% } %>