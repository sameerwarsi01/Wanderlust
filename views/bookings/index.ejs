<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-12 col-md-10 offset-md-1">
    <h3>My Bookings & Reservations</h3>
    <p class="text-muted">Manage your upcoming and past vacation trips.</p>
    <hr />

    <% if (bookings && bookings.length > 0) { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-2">
        <% for (let booking of bookings) { %>
          <% if (booking.listing) { %>
            <div class="col">
              <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                <img
                  src="<%= (booking.listing.image && booking.listing.image.url) ? booking.listing.image.url : booking.listing.image %>"
                  class="card-img-top"
                  alt="listing_image"
                  style="height: 14rem; object-fit: cover;"
                />
                <div class="card-body d-flex flex-column justify-content-between">
                  <div>
                    <h5 class="card-title fw-bold text-truncate"><%= booking.listing.title %></h5>
                    <p class="text-muted small mb-2">
                      <i class="fa-solid fa-location-dot"></i> <%= booking.listing.location %>, <%= booking.listing.country %>
                    </p>
                    
                    <div class="bg-light p-2 rounded-3 mb-3 small">
                      <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Check-In:</span>
                        <b><%= new Date(booking.checkIn).toLocaleDateString("en-IN") %></b>
                      </div>
                      <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Check-Out:</span>
                        <b><%= new Date(booking.checkOut).toLocaleDateString("en-IN") %></b>
                      </div>
                      <div class="d-flex justify-content-between border-top pt-1 mt-1">
                        <span class="text-secondary">Total Paid:</span>
                        <b class="text-success">&#8377; <%= (booking.totalPrice || 0).toLocaleString("en-IN") %></b>
                      </div>
                    </div>
                  </div>

                  <div class="d-flex justify-content-between align-items-center mt-2">
                    <a href="/listings/<%= booking.listing._id %>" class="btn btn-sm btn-outline-dark">View Listing</a>
                    <form method="POST" action="/bookings/<%= booking._id %>?_method=DELETE">
                      <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this reservation?')">Cancel Booking</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        <% } %>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <i class="fa-solid fa-suitcase-rolling fa-3x text-muted mb-3"></i>
        <h4>No reservations found!</h4>
        <p class="text-muted">You haven't made any bookings yet. Start exploring now.</p>
        <a href="/listings" class="btn btn-danger mt-2">Explore Listings</a>
      </div>
    <% } %>
  </div>
</div>