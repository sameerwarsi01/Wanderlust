<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/Booking.css" />
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<div class="row mt-3">
  <!-- Title -->
  <div class="col-12 col-md-10 offset-md-1">
    <h3><%= listing.title %></h3>
    <p class="text-muted"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
  </div>

  <!-- Image / Multi-image Carousel -->
  <div class="col-12 col-md-10 offset-md-1 mb-4">
    <% if (listing.images && listing.images.length > 1) { %>
      <!-- Multi-image Carousel -->
      <div id="listingCarousel" class="carousel slide rounded-4 overflow-hidden shadow-sm" data-bs-ride="false">
        <!-- Indicators (Dots) -->
        <div class="carousel-indicators">
          <% listing.images.forEach((img, idx) => { %>
            <button 
              type="button" 
              data-bs-target="#listingCarousel" 
              data-bs-slide-to="<%= idx %>" 
              class="<%= idx === 0 ? 'active' : '' %>" 
              aria-current="<%= idx === 0 ? 'true' : 'false' %>">
            </button>
          <% }) %>
        </div>

        <!-- Carousel Slides -->
        <div class="carousel-inner">
          <% listing.images.forEach((img, idx) => { %>
            <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
              <img 
                src="<%= img.url %>" 
                class="d-block w-100 show-img" 
                alt="listing_image" 
                style="height: 25rem; object-fit: cover;"
              />
            </div>
          <% }) %>
        </div>

        <!-- Controls (Arrows with dark shadow/filter for clear visibility) -->
        <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon bg-dark bg-opacity-50 rounded-circle p-3" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon bg-dark bg-opacity-50 rounded-circle p-3" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>

    <% } else if (listing.images && listing.images.length === 1) { %>
      <img
        src="<%= listing.images[0].url %>"
        class="card-img-top show-img rounded-4 shadow-sm"
        alt="listing_image"
        style="height: 25rem; object-fit: cover;"
      />
    <% } else if (listing.image && listing.image.url) { %>
      <img
        src="<%= listing.image.url %>"
        class="card-img-top show-img rounded-4 shadow-sm"
        alt="listing_image"
        style="height: 25rem; object-fit: cover;"
      />
    <% } %>
  </div>

  <!-- Main Content Grid -->
  <div class="col-12 col-md-10 offset-md-1">
    <div class="row">
      <!-- Left Column: Details, Reviews, Map -->
      <div class="col-12 col-lg-7">
        <h4>Hosted by <i><%= listing.owner ? listing.owner.username : "Host" %></i></h4>
        <hr />
        <p class="lead fs-6"><%= listing.description %></p>
        <hr />

        <!-- Host Actions (Edit/Delete) -->
        <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
          <div class="btns mb-4">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn px-4">Edit</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
              <button class="btn btn-dark">Delete</button>
            </form>
          </div>
          <hr />
        <% } %>

        <!-- Review Form -->
        <% if(currUser) { %>
          <h4>Leave a Review</h4>
          <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
              <label for="rating" class="form-label">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>

            <div class="mb-3 mt-3">
              <label for="comment" class="form-label">Comments</label>
              <textarea
                name="review[comment]"
                id="comment"
                cols="30"
                rows="4"
                class="form-control"
                required
              ></textarea>
              <div class="invalid-feedback">
                Please add some comments for review
              </div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
          </form>
          <hr />
        <% } %>

        <!-- All Reviews -->
        <% if(listing.reviews && listing.reviews.length > 0) { %>
          <h5><b>All Reviews (<%= listing.reviews.length %>)</b></h5>
          <div class="row">
            <% for(review of listing.reviews) { %>
              <div class="card col-12 col-md-5 mb-3 ms-md-2 p-2">
                <div class="card-body">
                  <h6 class="card-title">@<%= review.author ? review.author.username : "anonymous" %></h6>
                  <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                  <p class="card-text"><%= review.comment %></p>

                  <% if(currUser && review.author && currUser._id.equals(review.author._id)) { %>
                    <form
                      class="mb-1"
                      method="POST"
                      action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                    >
                      <button class="btn btn-sm btn-dark">Delete</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
          <hr />
        <% } %>

        <!-- Map Section -->
        <div class="mt-3 mb-4">
          <h5><b>Where you'll be</b></h5>
          <div id="map"></div>
        </div>
      </div>

      <!-- Right Column: Booking Card -->
      <div class="col-12 col-lg-5">
        <div class="booking-card shadow-sm p-4 rounded-4 border">
          <div class="d-flex justify-content-between align-items-baseline mb-3">
            <h4><b>&#8377; <%= (listing.price || 0).toLocaleString("en-IN") %></b> <span class="fs-6 text-muted font-monospace">/ night</span></h4>
          </div>

          <form id="bookingForm" class="needs-validation" novalidate>
            <div class="row g-2 mb-3">
              <div class="col-6">
                <label for="checkIn" class="form-label small fw-semibold">CHECK-IN</label>
                <input type="date" class="form-control" id="checkIn" name="checkIn" required />
              </div>
              <div class="col-6">
                <label for="checkOut" class="form-label small fw-semibold">CHECKOUT</label>
                <input type="date" class="form-control" id="checkOut" name="checkOut" required />
              </div>
            </div>

            <!-- Price Breakdown Calculation -->
            <div id="priceCalculation" class="d-none border-top pt-3 mb-3">
              <div class="d-flex justify-content-between text-muted mb-1">
                <span>&#8377;<%= listing.price %> x <span id="nightsCount">0</span> nights</span>
                <span>&#8377;<span id="basePrice">0</span></span>
              </div>
              <div class="d-flex justify-content-between text-muted mb-2">
                <span>GST (18%)</span>
                <span>&#8377;<span id="taxPrice">0</span></span>
              </div>
              <div class="d-flex justify-content-between fw-bold border-top pt-2 fs-5">
                <span>Total</span>
                <span>&#8377;<span id="totalPriceDisplay">0</span></span>
              </div>
            </div>

            <% if(currUser) { %>
              <button type="submit" class="btn btn-danger w-100 py-2 fs-6 fw-bold" id="reserveBtn" disabled>Reserve & Pay</button>
            <% } else { %>
              <a href="/login" class="btn btn-outline-danger w-100 py-2">Log in to Reserve</a>
            <% } %>
          </form>

          <!-- Contact Host Button -->
          <% if(currUser && listing.owner && !listing.owner._id.equals(currUser._id)) { %>
            <a href="/chat/<%= listing._id %>" class="btn btn-outline-dark mt-3 w-100 py-2">
              <i class="fa-regular fa-message me-2"></i>Contact Host
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.listingId = "<%= listing._id %>";
  window.listingPrice = Number("<%= listing.price || 0 %>");
  window.listingTitle = "<%= listing.title %>";
  window.coordinates = JSON.parse('<%- JSON.stringify((listing.geometry && listing.geometry.coordinates) ? listing.geometry.coordinates : [77.2090, 28.6139]) %>');
</script>
<script src="/js/booking.js"></script>